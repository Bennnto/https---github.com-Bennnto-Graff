#!/usr/bin/env python3
"""
Gaff Language Executable CLI (gaff)
Native Compiler Driver using Native Codegen for standalone release builds.
"""

import sys
import os
import argparse
import subprocess

# Ensure src and cli paths are imported cleanly
ROOT_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(ROOT_DIR, 'src'))
sys.path.insert(0, os.path.join(ROOT_DIR, 'cli'))

from parse import parser
from lexicals import lexer
from semantics import SymbolTable, Type_Infer, insert_auto_drop, BorrowChecker, BorrowError
from native_codegen import NativeCodegen
from repl import repl

def compile_native_release(input_path: str, output_binary: str = None, emit_c_only: bool = False, run_immediately: bool = False):
    if not os.path.exists(input_path):
        print(f"❌ Error: Source file '{input_path}' not found.")
        sys.exit(1)

    with open(input_path, 'r', encoding='utf-8') as f:
        source_code = f.read()

    os.makedirs("dist", exist_ok=True)
    base_name = os.path.splitext(os.path.basename(input_path))[0]
    c_path = os.path.join("dist", f"{base_name}.c")

    if output_binary is None:
        output_binary = os.path.join("dist", base_name)

    print(f"⚡ [Gaff Native Compiler] Compiling '{input_path}'...")

    # 1. Parse AST
    ast = parser.parse(source_code, lexer=lexer)
    if not ast:
        print("❌ Error: Parsing failed.")
        sys.exit(1)

    # 2. Type Inference & Static Borrow Checking Pass
    symtab = SymbolTable()
    inferrer = Type_Infer(symtab)
    inferrer.infer_program(ast)

    borrow_checker = BorrowChecker()
    try:
        borrow_checker.check_ast(ast)
    except BorrowError as err:
        print(f"❌ {err}")
        sys.exit(1)

    # 3. Scope Auto-Drop AST Pass
    ast = insert_auto_drop(ast)

    # 4. Native C Code Generation via NativeCodegen
    codegen_native = NativeCodegen()
    c_code = codegen_native.generate(ast, main_name="main")

    with open(c_path, 'w', encoding='utf-8') as f:
        f.write(c_code)

    print(f"  🟢 Generated Native C Source -> '{c_path}'")

    if emit_c_only:
        print("\n=== NATIVE C SOURCE OUTPUT ===")
        print(c_code)
        print("===============================\n")
        return

    # 5. Compile to Standalone Native Binary Executable via Clang/GCC (-O3)
    print(f"  🚀 Compiling Native Standalone Binary -> '{output_binary}'")

    clang_bin = "/opt/homebrew/opt/llvm/bin/clang"
    if not os.path.exists(clang_bin):
        clang_bin = "clang"

    compiled_native = False
    try:
        res = subprocess.run([clang_bin, "-O3", c_path, "-o", output_binary, "-lm"], capture_output=True, text=True)
        if res.returncode == 0:
            compiled_native = True
            print(f"  ✅ RELEASE BUILD SUCCESSFUL: '{output_binary}'")
        else:
            print(f"  ⚠️ Compiler Output: {res.stderr.strip()}")
    except FileNotFoundError:
        try:
            res = subprocess.run(["gcc", "-O3", c_path, "-o", output_binary, "-lm"], capture_output=True, text=True)
            if res.returncode == 0:
                compiled_native = True
                print(f"  ✅ RELEASE BUILD SUCCESSFUL: '{output_binary}'")
        except FileNotFoundError:
            print("❌ Error: Neither clang nor gcc native C compilers were found.")

    # 6. Run immediately if -r flag passed
    if run_immediately:
        print("\n▶️  Executing Release Standalone Native Binary:")
        print("-----------------------------------------------------------------")
        if compiled_native and os.path.exists(output_binary):
            subprocess.run([output_binary])
        else:
            print("❌ Error: Execution failed - Native binary was not generated.")
        print("-----------------------------------------------------------------")

def main():
    if len(sys.argv) == 1:
        repl()
        return

    parser_cli = argparse.ArgumentParser(description="Gaff Language CLI - Exclusive Native Codegen Compiler")
    parser_cli.add_argument("file", nargs="?", help="Path to .gaff source file")
    parser_cli.add_argument("-o", "--output", help="Output standalone executable path (default: dist/<name>)")
    parser_cli.add_argument("-r", "--run", action="store_true", help="Compile and execute release native binary immediately")
    parser_cli.add_argument("--emit-c", action="store_true", help="Emit generated Native C source code to stdout")

    args = parser_cli.parse_args()

    if args.file:
        compile_native_release(args.file, output_binary=args.output, emit_c_only=args.emit_c, run_immediately=args.run)
    else:
        repl()

if __name__ == "__main__":
    main()
