{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Graff",
  "scopeName": "source.graff",
  "patterns": [
    {
      "name": "comment.line.number-sign.graff",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.interpolated.graff",
      "begin": "\\$\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.graff",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.line.graff",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    {
      "name": "string.quoted.double.graff",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.graff",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.graff",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.graff",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.graff",
      "match": "\\b(let|fix|pub|fn|struct|enum|match|case|attempt|fallback|try|ok\\?|assert|assert_eq|timeline|rollback|return|break|continue|bind|import|if|else|while|for|in)\\b"
    },
    {
      "name": "storage.type.graff",
      "match": "\\b(int|str|float|bool|void)\\b"
    },
    {
      "name": "constant.language.boolean.graff",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "constant.numeric.float.graff",
      "match": "\\b\\d+\\.\\d+([eE][-+]?\\d+)?\\b"
    },
    {
      "name": "constant.numeric.integer.graff",
      "match": "\\b\\d+\\b"
    },
    {
      "name": "entity.name.function.graff",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
    },
    {
      "name": "keyword.operator.turbofish.graff",
      "match": "::<[^>]+>"
    },
    {
      "name": "keyword.operator.graff",
      "match": "(->|=>|::|\\.\\.|\\+|-|\\*|/|%|\\*\\*|==|!=|<=|>=|<|>|=|&|\\||\\^|~|!|@)"
    }
  ]
}
